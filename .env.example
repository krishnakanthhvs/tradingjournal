PORT=3000
DATABASE_URL=postgresql://localhost:5432/trading_journal
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Set to 1 only behind a trusted reverse proxy with HTTPS in production.
TRUST_PROXY=0
# Weekly summaries: verified sending domain required. Never expose these in the browser.
RESEND_API_KEY=
EMAIL_FROM=TradeJournal <journal@your-domain.com>
