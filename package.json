{
  "name": "trading-journal",
  "version": "1.0.0",
  "description": "Dynamic Trading Journal Dashboard",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test test/*.test.js",
    "email:weekly": "node scripts/weekly-email.js",
    "format": "prettier --write server.js lib scripts test public package.json README.md",
    "format:check": "prettier --check server.js lib scripts test public package.json README.md"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bootstrap-icons": "^1.13.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.7"
  }
}
